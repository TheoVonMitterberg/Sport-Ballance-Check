<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#009639">
  <title>Wochen-Sport-Check</title>
  <link rel="manifest" href="manifest.json">
  <style>
    :root {
      --green: #009639;
      --bg: #f6f7f8;
      --card: #ffffff;
      --text: #1f2933;
      --muted: #6b7280;
      --border: #d9dee3;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    main {
      max-width: 560px;
      margin: 0 auto;
      padding: 20px 16px 32px;
    }

    header {
      margin-bottom: 18px;
    }

    h1 {
      font-size: 1.6rem;
      margin: 0 0 6px;
    }

    p {
      margin: 0;
      color: var(--muted);
      line-height: 1.45;
    }

    .week-box,
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
    }

    .week-box {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .week-title {
      font-weight: 700;
    }

    button {
      border: 0;
      border-radius: 12px;
      padding: 10px 12px;
      background: var(--green);
      color: white;
      font-weight: 700;
      cursor: pointer;
    }

    button.secondary {
      background: #e5e7eb;
      color: var(--text);
    }

    .grid {
      display: grid;
      gap: 12px;
    }

    .card {
      display: grid;
      gap: 10px;
    }

    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .category {
      font-size: 1.05rem;
      font-weight: 800;
    }

    .days {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
    }

    label.day {
      display: grid;
      place-items: center;
      min-height: 44px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
      color: var(--muted);
      font-weight: 700;
      cursor: pointer;
      user-select: none;
    }

    label.day input {
      display: none;
    }

    label.day.checked {
      background: var(--green);
      border-color: var(--green);
      color: #fff;
    }

    .summary {
      margin-top: 14px;
      padding: 14px 16px;
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid var(--border);
      font-weight: 700;
    }

    .complete {
      color: var(--green);
    }

    .missing {
      color: #b45309;
    }

    .actions {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }

    .actions button {
      flex: 1;
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Wochen-Sport-Check</h1>
      <p>Hake pro Kalenderwoche ab, welche Trainingsbereiche du abgedeckt hast.</p>
    </header>

    <section class="week-box">
      <button class="secondary" id="prevWeek">‹</button>
      <div>
        <div class="week-title" id="weekLabel"></div>
        <p id="dateRange"></p>
      </div>
      <button class="secondary" id="nextWeek">›</button>
    </section>

    <section class="grid" id="checklist"></section>

    <div class="summary" id="summary"></div>

    <div class="actions">
      <button class="secondary" id="currentWeek">Aktuelle Woche</button>
      <button id="resetWeek">Woche zurücksetzen</button>
    </div>
  </main>

  <script>
    const categories = [
      "Unterkörper",
      "Oberkörper Push",
      "Oberkörper Pull",
      "Core & Stabilität",
      "Cardio & Kondition"
    ];

    const days = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];
    let currentDate = new Date();

    const checklist = document.getElementById("checklist");
    const weekLabel = document.getElementById("weekLabel");
    const dateRange = document.getElementById("dateRange");
    const summary = document.getElementById("summary");

    function getMonday(date) {
      const d = new Date(date);
      const day = d.getDay();
      const diff = d.getDate() - day + (day === 0 ? -6 : 1);
      d.setDate(diff);
      d.setHours(0, 0, 0, 0);
      return d;
    }

    function getISOWeek(date) {
      const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
      const dayNum = d.getUTCDay() || 7;
      d.setUTCDate(d.getUTCDate() + 4 - dayNum);
      const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
      const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
      return { year: d.getUTCFullYear(), week: weekNo };
    }

    function formatDate(date) {
      return date.toLocaleDateString("de-AT", { day: "2-digit", month: "2-digit", year: "numeric" });
    }

    function getStorageKey() {
      const monday = getMonday(currentDate);
      const iso = getISOWeek(monday);
      return `sportcheck-${iso.year}-KW${iso.week}`;
    }

    function loadData() {
      return JSON.parse(localStorage.getItem(getStorageKey())) || {};
    }

    function saveData(data) {
      localStorage.setItem(getStorageKey(), JSON.stringify(data));
    }

    function render() {
      const monday = getMonday(currentDate);
      const sunday = new Date(monday);
      sunday.setDate(monday.getDate() + 6);
      const iso = getISOWeek(monday);
      const data = loadData();

      weekLabel.textContent = `KW ${iso.week} / ${iso.year}`;
      dateRange.textContent = `${formatDate(monday)} bis ${formatDate(sunday)}`;
      checklist.innerHTML = "";

      categories.forEach(category => {
        const card = document.createElement("div");
        card.className = "card";

        const head = document.createElement("div");
        head.className = "card-head";

        const title = document.createElement("div");
        title.className = "category";
        title.textContent = category;

        const status = document.createElement("span");
        const isDone = days.some(day => data[category]?.[day]);
        status.textContent = isDone ? "erledigt" : "offen";
        status.className = isDone ? "complete" : "missing";

        head.append(title, status);

        const dayGrid = document.createElement("div");
        dayGrid.className = "days";

        days.forEach(day => {
          const label = document.createElement("label");
          label.className = "day";
          if (data[category]?.[day]) label.classList.add("checked");

          const input = document.createElement("input");
          input.type = "checkbox";
          input.checked = Boolean(data[category]?.[day]);

          input.addEventListener("change", () => {
            const updated = loadData();
            updated[category] = updated[category] || {};
            updated[category][day] = input.checked;
            saveData(updated);
            render();
          });

          label.append(input, document.createTextNode(day));
          dayGrid.appendChild(label);
        });

        card.append(head, dayGrid);
        checklist.appendChild(card);
      });

      const completed = categories.filter(category => days.some(day => data[category]?.[day]));
      const missing = categories.filter(category => !days.some(day => data[category]?.[day]));

      if (missing.length === 0) {
        summary.innerHTML = `<span class="complete">Woche vollständig:</span> alle 5 Kategorien abgedeckt.`;
      } else {
        summary.innerHTML = `<span class="missing">Noch offen:</span> ${missing.join(", ")}`;
      }
    }

    document.getElementById("prevWeek").addEventListener("click", () => {
      currentDate.setDate(currentDate.getDate() - 7);
      render();
    });

    document.getElementById("nextWeek").addEventListener("click", () => {
      currentDate.setDate(currentDate.getDate() + 7);
      render();
    });

    document.getElementById("currentWeek").addEventListener("click", () => {
      currentDate = new Date();
      render();
    });

    document.getElementById("resetWeek").addEventListener("click", () => {
      if (confirm("Diese Kalenderwoche wirklich zurücksetzen?")) {
        localStorage.removeItem(getStorageKey());
        render();
      }
    });

    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("service-worker.js");
    }

    render();
  </script>
</body>
</html>
